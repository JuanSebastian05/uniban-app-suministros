  },
  "paths": {
    "/api/v1/harvests": {
      "post": {
        "tags": [
          "cosechas y despachos"
        ],
        "summary": "Harvest",
        "operationId": "harvest_api_v1_harvests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HarvestIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivitySyncOut"
                }
              }
            }
          },
          "200": {
            "description": "Cosecha ya recibida, idéntica."
          },
          "409": {
            "description": "Conflicto de cupo, etapa, contexto o UUID."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/dispatches": {
      "post": {
        "tags": [
          "cosechas y despachos"
        ],
        "summary": "Dispatch",
        "operationId": "dispatch_api_v1_dispatches_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DispatchIn-Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivitySyncOut"
                }
              }
            }
          },
          "200": {
            "description": "Despacho ya recibido, idéntico."
          },
          "409": {
            "description": "Faltante de producto o empaques, etapa, contexto o UUID."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/production/{parcel_id}": {
      "get": {
        "tags": [
          "cosechas y despachos"
        ],
        "summary": "History",
        "operationId": "history_api_v1_production__parcel_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "parcel_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Parcel Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductionHistoryOut"
                }
              }
            }
          },
          "404": {
            "description": "Parcela inexistente o ajena."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
