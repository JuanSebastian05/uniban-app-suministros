        <mxCell id="harvests" value="COSECHAS REALES (harvests)&#10;PK/FK id → activities.id (misma operación)&#10;FK parcel_id, cycle_id&#10;FK recommendation_id, aforamiento_id&#10;period, quantity INT &gt; 0, date&#10;exception_confirmed&#10;request_payload JSONB, received_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
