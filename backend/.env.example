# Copiar como .env (NO se versiona) y completar con valores locales.

APP_NAME=Uniban Suministros API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# PostgreSQL (formato SQLAlchemy + psycopg 3). Reemplazar usuario/clave/base.
# Neon: copiar la cadena desde Console > Connect y cambiar el inicio "postgresql://" por
# "postgresql+psycopg://". Conservar sslmode=require. Nunca subir el .env real.
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@localhost:5432/uniban_suministros

# Orígenes CORS permitidos, separados por coma (vacío = CORS desactivado).
CORS_ORIGINS=http://localhost:3000
