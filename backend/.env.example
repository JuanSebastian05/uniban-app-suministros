# Copiar como .env (NO se versiona) y completar con valores locales.

APP_NAME=Uniban Suministros API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# PostgreSQL (formato SQLAlchemy + psycopg 3). Reemplazar usuario/clave/base.
# Neon: copiar la cadena desde Console > Connect y cambiar el inicio "postgresql://" por
# "postgresql+psycopg://". Conservar sslmode=require. Nunca subir el .env real.
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@localhost:5432/uniban_suministros

# ID del proyecto de Firebase (Configuración del proyecto > General). Necesario para
# verificar el token de quien se registra; no es un secreto.
FIREBASE_PROJECT_ID=

# Clave de servicio para el Equipo 1 (cabecera X-API-Key en /api/v1/service/*). Es un secreto: va
# solo en Render y en tu .env real. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vacía = esas rutas responden 503.
SERVICE_API_KEY=

# Servicio de recomendaciones del Equipo 2 (HU_12). La URL tiene valor por defecto; la clave es opcional
# (hoy su API no la pide). Si la usan, es un secreto: solo en Render y en tu .env real.
EQUIPO2_BASE_URL=https://platano-logistica-api.onrender.com
EQUIPO2_API_KEY=

# Orígenes CORS permitidos, separados por coma (vacío = CORS desactivado).
CORS_ORIGINS=http://localhost:3000
